---
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();

const columns = [
  {
    heading: 'Research',
    links: [
      { href: '/research', label: 'Research overview' },
      { href: '/research/esg-and-ports', label: 'ESG & Ports' },
      { href: '/research/regions', label: 'Regions' },
      { href: '/research/methodology', label: 'Methodology' },
    ],
  },
  {
    heading: 'Outputs',
    links: [
      { href: '/research/outputs', label: 'Publications' },
      { href: '/research/journey', label: 'The Journey' },
      { href: '/dashboard', label: 'ESG Dashboard' },
      { href: '/knowledge-hub', label: 'ESG Knowledge Hub' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-brand">
      <p class="footer-name">Masego Mosupye</p>
      <p class="footer-role">Doctoral Researcher, World Maritime University, Malmö, Sweden</p>
      <p class="footer-blurb">
        Developing a unified ESG framework for sustainability management in ports and shipping
        companies in emerging maritime regions.
      </p>
    </div>

    <div class="footer-grid">
      {
        columns.map((column) => (
          <nav class="footer-col" aria-label={column.heading}>
            <h2 class="footer-heading">{column.heading}</h2>
            <ul>
              {column.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div class="footer-col">
        <h2 class="footer-heading">Connect</h2>
        <ul>
          <li><a href="mailto:masegomosupye@gmail.com">masegomosupye@gmail.com</a></li>
          <li><a href="/contact">Collaboration enquiries</a></li>
        </ul>
        <SocialLinks variant="list" class="footer-social" />
      </div>

      <div class="footer-col">
        <h2 class="footer-heading">About</h2>
        <ul>
          <li><a href="/about">About the researcher</a></li>
          <li><a href="/contact">Contact & collaboration</a></li>
          <li>
            <a href="https://www.wmu.se/" target="_blank" rel="noopener noreferrer">
              World Maritime University
            </a>
          </li>
        </ul>
        <p class="footer-status" role="status">
          <span class="pulse-dot"></span>
          <span>ESG framework under development</span>
        </p>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} Masego Mosupye. All rights reserved.</p>
      <p class="footer-credit">
        <span>Website by</span>{' '}
        <a href="https://learning254.com" target="_blank" rel="noopener noreferrer">Learning254.com</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy-900);
    color: rgba(255, 255, 255, 0.72);
    padding-block: clamp(3rem, 7vw, 4.5rem) 2rem;
    margin-top: auto;
  }

  .footer-brand {
    max-width: 46ch;
    padding-bottom: clamp(2rem, 4vw, 2.75rem);
    margin-bottom: clamp(2rem, 4vw, 2.75rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .footer-name {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 0.25rem;
  }

  .footer-role {
    font-size: 0.875rem;
    color: var(--teal-400);
    margin-bottom: 0.9rem;
  }

  .footer-blurb {
    font-size: 0.9375rem;
    line-height: 1.7;
    margin: 0;
  }

  .footer-grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
  }

  .footer-heading {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 1rem;
  }

  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-col li {
    margin-bottom: 0.55rem;
  }

  .footer-col a {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .footer-col a:hover {
    color: var(--teal-400);
    text-decoration: underline;
  }

  .footer-social {
    margin-top: 1.25rem;
  }

  .footer-status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.25rem;
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius-pill);
    background: rgba(249, 115, 22, 0.12);
    border: 1px solid rgba(249, 115, 22, 0.3);
    color: #fdba74;
    font-size: 0.8125rem;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer-credit a {
    color: var(--teal-400);
    font-weight: 600;
    text-decoration: none;
  }

  .footer-credit a:hover {
    text-decoration: underline;
  }
</style>
