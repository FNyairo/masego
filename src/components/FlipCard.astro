---
/**
 * 3D flip card for the E/S/G dimensions.
 *
 * Front: icon, dimension name, one-line tagline.
 * Back: full description plus what the dimension covers.
 *
 * Both faces stay in the DOM so screen readers reach the back content without
 * flipping, and under prefers-reduced-motion the card renders as a single stacked
 * panel with no rotation at all.
 */
interface Props {
  id: string;
  letter: string;
  title: string;
  tagline: string;
  description: string;
  points: string[];
  icon: 'environmental' | 'social' | 'governance';
}

const { id, letter, title, tagline, description, points, icon } = Astro.props;

const icons = {
  environmental:
    'M12 3c-4 3.2-6.5 6.3-6.5 9.6A6.5 6.5 0 0 0 12 19a6.5 6.5 0 0 0 6.5-6.4C18.5 9.3 16 6.2 12 3Zm0 14.2V6.1c2.7 2.4 4.5 4.8 4.5 6.5a4.5 4.5 0 0 1-4.5 4.6Z',
  social:
    'M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm7.5.5a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM9 13c-3.3 0-6 1.8-6 4v2h12v-2c0-2.2-2.7-4-6-4Zm7.5.5c-.9 0-1.7.1-2.4.4 1.2 1 1.9 2.3 1.9 3.6V19H22v-1.6c0-2.1-2.5-3.9-5.5-3.9Z',
  governance:
    'M12 2 3 6v2h18V6l-9-4ZM5 10v7H3v2h18v-2h-2v-7h-2v7h-3v-7h-2v7H8v-7H5Z',
};
---

<div class="flip-card" data-flip-card>
  <button
    type="button"
    class="flip-card-inner"
    id={id}
    aria-pressed="false"
    aria-label={`${title}: ${tagline}. Activate to show what this dimension covers.`}
  >
    <span class="flip-face flip-front">
      <span class="flip-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="28" height="28" focusable="false">
          <path fill="currentColor" d={icons[icon]}></path>
        </svg>
      </span>
      <span class="flip-letter" aria-hidden="true">{letter}</span>
      <span class="flip-title">{title}</span>
      <span class="flip-tagline">{tagline}</span>
      <span class="flip-hint" aria-hidden="true">
        Tap to read more
        <svg viewBox="0 0 20 20" width="14" height="14" focusable="false">
          <path
            d="M4 10h11M11 5l5 5-5 5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
    </span>

    <span class="flip-face flip-back">
      <span class="flip-back-title">{title}</span>
      <span class="flip-description">{description}</span>
      <ul class="flip-points">
        {points.map((point) => <li>{point}</li>)}
      </ul>
    </span>
  </button>
</div>

<style>
  .flip-card {
    perspective: 1200px;
    height: 420px;
  }

  .flip-card-inner {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    background: none;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
    transform-style: preserve-3d;
    transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: var(--radius-lg);
  }

  .flip-card.flipped .flip-card-inner {
    transform: rotateY(180deg);
  }

  .flip-face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2rem);
    border-radius: var(--radius-lg);
    border: 1px solid var(--slate-100);
    background: #ffffff;
    box-shadow: var(--shadow-xs);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    overflow: hidden;
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  }

  .flip-back {
    transform: rotateY(180deg);
    background: linear-gradient(160deg, #ffffff 0%, var(--seafoam-100) 160%);
  }

  /* Hover / focus lift and teal glow on whichever face is showing */
  .flip-card-inner:hover .flip-face,
  .flip-card-inner:focus-visible .flip-face {
    border-color: rgba(45, 212, 191, 0.65);
    box-shadow: 0 16px 40px rgba(10, 31, 51, 0.14), 0 0 0 4px rgba(45, 212, 191, 0.14);
  }

  .flip-card:has(.flip-card-inner:hover),
  .flip-card:has(.flip-card-inner:focus-visible) {
    transform: translateY(-5px);
    transition: transform 0.22s ease;
  }

  .flip-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 16px;
    background: var(--gradient-accent);
    color: #04231f;
    margin-bottom: 1.1rem;
  }

  .flip-letter {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--teal-700);
    margin-bottom: 0.35rem;
  }

  .flip-title,
  .flip-back-title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 600;
    color: var(--navy-900);
    line-height: 1.2;
  }

  .flip-back-title {
    margin-bottom: 0.6rem;
  }

  .flip-tagline {
    font-size: 0.9688rem;
    color: var(--slate-600);
    margin-top: 0.6rem;
    flex: 1;
  }

  .flip-hint {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--teal-700);
    margin-top: auto;
  }

  .flip-description {
    font-size: 0.9375rem;
    color: var(--slate-600);
    margin-bottom: 0.9rem;
  }

  .flip-points {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .flip-points li {
    position: relative;
    padding-left: 1.35rem;
    margin-bottom: 0.4rem;
    font-size: 0.875rem;
    color: var(--slate-600);
  }

  .flip-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--teal-600);
  }

  /* No rotation when the visitor prefers reduced motion: both faces stack. */
  @media (prefers-reduced-motion: reduce) {
    .flip-card,
    .flip-card.flipped .flip-card-inner {
      height: auto;
      perspective: none;
      transform: none;
    }

    .flip-card-inner {
      height: auto;
      transform: none !important;
      transform-style: flat;
      cursor: default;
    }

    .flip-face {
      position: static;
      transform: none !important;
      backface-visibility: visible;
      -webkit-backface-visibility: visible;
    }

    .flip-front {
      border-bottom-left-radius: 0;
      border-bottom-right-radius: 0;
      border-bottom: none;
    }

    .flip-back {
      border-top-left-radius: 0;
      border-top-right-radius: 0;
    }

    .flip-hint {
      display: none;
    }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll('[data-flip-card]').forEach((card) => {
    const trigger = card.querySelector('.flip-card-inner');
    if (!(trigger instanceof HTMLElement)) return;

    const toggle = () => {
      if (reduce.matches) return; // both faces are already visible
      const flipped = card.classList.toggle('flipped');
      trigger.setAttribute('aria-pressed', flipped ? 'true' : 'false');
    };

    trigger.addEventListener('click', toggle);

    // A <button> fires click on Enter by itself. Space is handled here instead:
    // preventDefault stops the page scrolling, and because that also suppresses
    // the synthetic click, the flip is triggered explicitly.
    trigger.addEventListener('keydown', (event) => {
      if (event.key !== ' ' && event.key !== 'Spacebar') return;
      event.preventDefault();
      toggle();
    });
  });
</script>
