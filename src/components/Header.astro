---
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';

const researchLinks = [
  { href: '/research', label: 'Research Overview' },
  { href: '/research/esg-and-ports', label: 'ESG & Ports' },
  { href: '/research/regions', label: 'Regions' },
  { href: '/research/methodology', label: 'Methodology' },
  { href: '/research/outputs', label: 'Outputs' },
  { href: '/research/journey', label: 'The Journey' },
];

const isCurrent = (href: string) => pathname === href;
const researchActive = pathname === '/research' || pathname.startsWith('/research/');
---

<header id="siteHeader" class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="32" height="32" focusable="false">
          <circle cx="16" cy="16" r="15" fill="none" stroke="currentColor" stroke-width="2"></circle>
          <path
            d="M4 20c3 0 3-3 6-3s3 3 6 3 3-3 6-3 3 3 6 3"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
          <path d="M16 6v11M11 11h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"
          ></path>
        </svg>
      </span>
      <span class="brand-text">
        <span class="brand-name">Masego Mosupye</span>
        <span class="brand-role">ESG &amp; Sustainable Ports Research</span>
      </span>
    </a>

    <button
      type="button"
      class="nav-toggle"
      id="navToggle"
      aria-expanded="false"
      aria-controls="navLinks"
      aria-label="Open navigation menu"
    >
      <span class="nav-toggle-bars" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>

    <nav class="site-nav" aria-label="Primary">
      <ul class="nav-links" id="navLinks">
        <li>
          <a href="/" class:list={['nav-link', { active: isCurrent('/') }]} aria-current={isCurrent('/') ? 'page' : undefined}>Home</a>
        </li>

        <li class="nav-item-dropdown">
          <button
            type="button"
            class:list={['nav-link', 'nav-trigger', { active: researchActive }]}
            id="researchTrigger"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="researchMenu"
          >
            Research
            <svg class="chevron" viewBox="0 0 20 20" width="14" height="14" aria-hidden="true" focusable="false">
              <path
                d="M5 8l5 5 5-5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
          <ul class="dropdown" id="researchMenu" role="menu" aria-labelledby="researchTrigger">
            {
              researchLinks.map((link) => (
                <li role="none">
                  <a
                    role="menuitem"
                    href={link.href}
                    class:list={['dropdown-link', { active: isCurrent(link.href) }]}
                    aria-current={isCurrent(link.href) ? 'page' : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </li>

        <li>
          <a href="/dashboard" class:list={['nav-link', { active: isCurrent('/dashboard') }]} aria-current={isCurrent('/dashboard') ? 'page' : undefined}>Dashboard</a>
        </li>
        <li>
          <a href="/knowledge-hub" class:list={['nav-link', { active: isCurrent('/knowledge-hub') }]} aria-current={isCurrent('/knowledge-hub') ? 'page' : undefined}>Knowledge Hub</a>
        </li>
        <li>
          <a href="/about" class:list={['nav-link', { active: isCurrent('/about') }]} aria-current={isCurrent('/about') ? 'page' : undefined}>About</a>
        </li>
        <li>
          <a href="/contact" class:list={['nav-link', { active: isCurrent('/contact') }]} aria-current={isCurrent('/contact') ? 'page' : undefined}>Contact</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 100;
    background: transparent;
    transition: background-color 0.28s ease, box-shadow 0.28s ease, backdrop-filter 0.28s ease;
  }

  .site-header.scrolled,
  .site-header.nav-open {
    background: rgba(10, 31, 51, 0.96);
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 24px rgba(10, 31, 51, 0.18);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--header-height);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: #ffffff;
    text-decoration: none;
    padding-block: 0.5rem;
  }

  .brand:hover {
    color: var(--seafoam-100);
  }

  .brand-mark {
    color: var(--teal-400);
    display: inline-flex;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .brand-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }

  .brand-role {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(204, 251, 241, 0.75);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-links li {
    margin: 0;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.55rem 0.85rem;
    border-radius: var(--radius-pill);
    color: rgba(255, 255, 255, 0.86);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    background: none;
    border: none;
    font-family: inherit;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.18s ease, color 0.18s ease;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
  }

  .nav-link.active {
    color: #ffffff;
    background: rgba(45, 212, 191, 0.2);
    box-shadow: inset 0 0 0 1px rgba(45, 212, 191, 0.45);
  }

  .nav-item-dropdown {
    position: relative;
  }

  .chevron {
    transition: transform 0.2s ease;
  }

  .nav-trigger[aria-expanded='true'] .chevron {
    transform: rotate(180deg);
  }

  .dropdown {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    min-width: 232px;
    margin: 0;
    padding: 0.4rem;
    list-style: none;
    background: #ffffff;
    border: 1px solid var(--slate-100);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
  }

  .nav-item-dropdown.open .dropdown {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .dropdown li {
    margin: 0;
  }

  .dropdown-link {
    display: block;
    padding: 0.55rem 0.75rem;
    border-radius: 8px;
    color: var(--navy-800);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .dropdown-link:hover,
  .dropdown-link:focus-visible {
    background: var(--seafoam-100);
    color: var(--navy-900);
  }

  .dropdown-link.active {
    background: var(--seafoam-100);
    color: var(--navy-900);
    font-weight: 600;
  }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.28);
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    cursor: pointer;
  }

  .nav-toggle-bars {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 18px;
  }

  .nav-toggle-bars span {
    display: block;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
  }

  @media (max-width: 959px) {
    .header-inner {
      flex-wrap: wrap;
      align-items: center;
    }

    .nav-toggle {
      display: inline-flex;
      order: 3;
    }

    .site-nav {
      order: 4;
      flex-basis: 100%;
      width: 100%;
    }

    .nav-links {
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0.15rem;
      padding: 0.75rem 0 1.25rem;
      max-height: calc(100vh - var(--header-height));
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    .nav-links.open {
      display: flex;
    }

    .nav-link {
      width: 100%;
      justify-content: space-between;
      border-radius: var(--radius-sm);
      padding: 0.75rem 0.9rem;
    }

    .dropdown {
      position: static;
      display: none;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: none;
      background: rgba(255, 255, 255, 0.06);
      border-color: rgba(255, 255, 255, 0.14);
      margin: 0.25rem 0 0.5rem;
    }

    .nav-item-dropdown.open .dropdown {
      display: block;
    }

    .dropdown-link {
      color: rgba(255, 255, 255, 0.88);
      padding: 0.65rem 0.9rem;
    }

    .dropdown-link:hover,
    .dropdown-link:focus-visible,
    .dropdown-link.active {
      background: rgba(45, 212, 191, 0.18);
      color: #ffffff;
    }
  }

  @media (max-width: 479px) {
    .brand-role {
      display: none;
    }
  }
</style>

<script is:inline>
  (function () {
    const header = document.getElementById('siteHeader');
    const toggle = document.getElementById('navToggle');
    const navLinks = document.getElementById('navLinks');
    const trigger = document.getElementById('researchTrigger');
    const menu = document.getElementById('researchMenu');
    const dropdown = trigger ? trigger.closest('.nav-item-dropdown') : null;
    const desktop = window.matchMedia('(min-width: 960px)');

    // `pinned` records that the menu was opened deliberately (click or keyboard),
    // so that moving the pointer away does not close it.
    let pinned = false;

    function openDropdown() {
      if (!dropdown || !trigger) return;
      dropdown.classList.add('open');
      trigger.setAttribute('aria-expanded', 'true');
    }

    function closeDropdown(returnFocus) {
      if (!dropdown || !trigger) return;
      pinned = false;
      dropdown.classList.remove('open');
      trigger.setAttribute('aria-expanded', 'false');
      if (returnFocus) trigger.focus();
    }

    function closeMobileNav() {
      if (!navLinks || !toggle) return;
      navLinks.classList.remove('open');
      if (header) header.classList.remove('nav-open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open navigation menu');
    }

    if (toggle && navLinks) {
      toggle.addEventListener('click', function () {
        const open = navLinks.classList.toggle('open');
        if (header) header.classList.toggle('nav-open', open);
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        toggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
        if (!open) closeDropdown(false);
      });
    }

    if (trigger && dropdown && menu) {
      trigger.addEventListener('click', function () {
        if (pinned) {
          closeDropdown(false);
        } else {
          openDropdown();
          pinned = true;
        }
      });

      dropdown.addEventListener('mouseenter', function () {
        if (desktop.matches) openDropdown();
      });

      dropdown.addEventListener('mouseleave', function () {
        if (desktop.matches && !pinned) closeDropdown(false);
      });

      dropdown.addEventListener('focusin', function () {
        if (desktop.matches) openDropdown();
      });

      dropdown.addEventListener('focusout', function (event) {
        if (!desktop.matches || pinned) return;
        if (!dropdown.contains(event.relatedTarget)) closeDropdown(false);
      });

      dropdown.addEventListener('keydown', function (event) {
        if (event.key !== 'Escape') return;
        if (dropdown.classList.contains('open')) {
          event.stopPropagation();
          closeDropdown(true);
        }
      });

      document.addEventListener('click', function (event) {
        if (!dropdown.contains(event.target)) closeDropdown(false);
      });
    }

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') {
        closeDropdown(false);
        closeMobileNav();
      }
    });

    if (navLinks) {
      navLinks.querySelectorAll('a').forEach(function (link) {
        link.addEventListener('click', function () {
          closeMobileNav();
          closeDropdown(false);
        });
      });
    }

    desktop.addEventListener('change', function () {
      closeMobileNav();
      closeDropdown(false);
    });

    if (header) {
      header.classList.toggle('scrolled', window.scrollY > 40);
    }
  })();
</script>
