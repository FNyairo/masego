---
/**
 * Social and academic profile links.
 *
 * Only the LinkedIn URL is confirmed. The rest are placeholders pointing at each
 * platform's home page — replace the `href` values below with Masego's own profile
 * URLs, or delete the entries that do not apply.
 *
 * variant="list"  → icon + visible text label, stacked (used in the footer)
 * variant="row"   → icon-only buttons in a row, labelled with aria-label
 */
interface Props {
  variant?: 'list' | 'row';
  class?: string;
}

const { variant = 'row', class: className } = Astro.props;

const links = [
  { name: 'LinkedIn', href: 'https://www.linkedin.com/in/masegomosupye/', placeholder: false, icon: 'linkedin' },
  { name: 'Google Scholar', href: 'https://scholar.google.com/', placeholder: true, icon: 'scholar' },
  { name: 'ORCID', href: 'https://orcid.org/', placeholder: true, icon: 'orcid' },
  { name: 'Instagram', href: 'https://instagram.com/', placeholder: true, icon: 'instagram' },
  { name: 'Facebook', href: 'https://facebook.com/', placeholder: true, icon: 'facebook' },
  { name: 'X', href: 'https://x.com/', placeholder: true, icon: 'x' },
];

const paths: Record<string, string> = {
  linkedin:
    'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.76V21h-4v-5.6c0-1.34-.03-3.06-1.9-3.06-1.9 0-2.2 1.45-2.2 2.96V21h-4V9Z',
  scholar: 'M12 2 1 8l11 6 9-4.91V17h2V8L12 2ZM5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82Z',
  orcid:
    'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20ZM8.37 6.38a.98.98 0 1 1 0 1.96.98.98 0 0 1 0-1.96ZM7.6 9.28h1.55v7.9H7.6v-7.9Zm3.2 0h3.06c2.9 0 4.18 2.08 4.18 3.95 0 2.03-1.59 3.95-4.16 3.95H10.8v-7.9Zm1.55 1.4v5.1h1.38c1.96 0 2.71-1.49 2.71-2.55 0-1.13-.72-2.55-2.74-2.55h-1.35Z',
  instagram:
    'M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9a3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07Zm0 5.68a4.16 4.16 0 1 0 0 8.32 4.16 4.16 0 0 0 0-8.32Zm0 6.86a2.7 2.7 0 1 1 0-5.4 2.7 2.7 0 0 1 0 5.4Zm5.3-7.03a.97.97 0 1 1-1.94 0 .97.97 0 0 1 1.94 0Z',
  facebook:
    'M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.45 2.89h-2.33v6.99A10 10 0 0 0 22 12Z',
  x: 'M17.53 3h3.04l-6.64 7.59L21.75 21h-6.12l-4.79-6.26L5.35 21H2.3l7.1-8.12L2.25 3h6.28l4.33 5.72L17.53 3Zm-1.07 16.17h1.69L7.62 4.73H5.81l10.65 14.44Z',
};
---

<ul class:list={['social-links', `social-links--${variant}`, className]}>
  {
    links.map((link) => (
      <li>
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={variant === 'row' ? `${link.name} (opens in a new tab)` : undefined}
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
            <path fill="currentColor" d={paths[link.icon]} />
          </svg>
          {variant === 'list' && <span>{link.name}</span>}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.5rem;
  }

  .social-links li {
    margin: 0;
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    transition: color 0.18s ease, border-color 0.18s ease, background-color 0.18s ease,
      transform 0.18s ease;
  }

  /* Row of icon-only buttons */
  .social-links--row {
    flex-wrap: wrap;
  }

  .social-links--row a {
    width: 42px;
    height: 42px;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid var(--slate-100);
    background: #ffffff;
    color: var(--navy-800);
    box-shadow: var(--shadow-xs);
  }

  .social-links--row a:hover {
    border-color: var(--teal-400);
    color: var(--teal-700);
    transform: translateY(-2px);
  }

  /* Stacked list with visible labels */
  .social-links--list {
    flex-direction: column;
    gap: 0.55rem;
  }

  .social-links--list a {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.9375rem;
  }

  .social-links--list a:hover {
    color: var(--teal-400);
  }

  .social-links--list svg {
    flex: none;
  }
</style>
