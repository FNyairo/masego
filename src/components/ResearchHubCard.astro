---
interface Props {
  href: string;
  title: string;
  description: string;
  index?: string;
}

const { href, title, description, index } = Astro.props;
---

<a class="hub-card card card--link reveal" href={href}>
  {index && <span class="hub-index" aria-hidden="true">{index}</span>}
  <h3 class="hub-title">{title}</h3>
  <p class="hub-desc">{description}</p>
  <span class="hub-arrow">
    <span>Read more</span>
    <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true" focusable="false">
      <path
        d="M4 10h11M11 5l5 5-5 5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </span>
</a>

<style>
  .hub-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .hub-index {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--teal-700);
  }

  .hub-title {
    margin-bottom: 0.35rem;
  }

  .hub-desc {
    font-size: 0.9688rem;
    color: var(--slate-600);
    flex: 1;
  }

  .hub-arrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--teal-700);
  }

  .hub-arrow svg {
    transition: transform 0.2s ease;
  }

  .hub-card:hover .hub-arrow svg,
  .hub-card:focus-visible .hub-arrow svg {
    transform: translateX(4px);
  }
</style>
